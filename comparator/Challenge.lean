/-! ### Main Theorems (Section 1 & Section 7) -/

/-- **Theorem A**: For every even `n ≥ 8`, `c_n = n - 1` if `n - 1` is prime and `c_n = 1`
otherwise; equivalently, `(n!)^3 ∣ Δ_n` when `n - 1` is composite, and
`(n!)^3 / (n - 1) ∣ Δ_n` while `(n!)^3 ∤ Δ_n` when `n - 1` is prime. -/
theorem thm_A (n : ℕ) (heven : Even n) (hn : 8 ≤ n) :
    cVal n = (if (n - 1).Prime then n - 1 else 1) ∧
    (¬ (n - 1).Prime → ((n.factorial : ℤ) ^ 3 ∣ delta n)) ∧
    ((n - 1).Prime →
      (((n.factorial ^ 3 / (n - 1) : ℕ) : ℤ) ∣ delta n) ∧
      ¬ ((n.factorial : ℤ) ^ 3 ∣ delta n)) :=
  sorry

/-- **Theorem B**: For every even `n ≥ 8` and every prime `q ≤ n - 2`, the natural modulus
`M_q(n) = q^(v_q(n!) + v_q(n))` divides `D_n`. -/
theorem thm_B (n q : ℕ) (heven : Even n) (hn : 8 ≤ n) (hq : q.Prime) (hqle : q ≤ n - 2) :
    (naturalModulus q n : ℤ) ∣ reducedDelta n :=
  sorry

/-- **Theorem C**: For every even `n` and every prime `q`,
`v_q(L^e_n - L^o_n) ≥ v_q((n-1)!) + ∑_{N=1}^{n-1} f_q(n, N)`, which is at least
`v_q(n! (n-1)!) + a(a-1)/2` for `a = ⌊n/q⌋`, and at least `v_2((n-1)!) + n^2/4` for `q = 2`. -/
theorem thm_C (n q : ℕ) (heven : Even n) (hq : q.Prime) :
    qVal q (delta n) ≥
      (padicValNat q (n - 1).factorial : ℕ∞) +
        (∑ N ∈ Finset.Icc 1 (n - 1), fVal q n N : ℕ∞) ∧
    (padicValNat q (n - 1).factorial : ℕ∞) +
        (∑ N ∈ Finset.Icc 1 (n - 1), fVal q n N : ℕ∞) ≥
      (padicValNat q (n.factorial * (n - 1).factorial) : ℕ∞) +
        (((n / q) * (n / q - 1) / 2 : ℕ) : ℕ∞) ∧
    (q = 2 →
      (padicValNat 2 (n - 1).factorial : ℕ∞) +
          (∑ N ∈ Finset.Icc 1 (n - 1), fVal 2 n N : ℕ∞) ≥
        (padicValNat 2 (n - 1).factorial : ℕ∞) + ((n ^ 2 / 4 : ℕ) : ℕ∞)) :=
  sorry

/-! ### Section 1 & Section 2: Notation and Known Facts -/

/-- **Section 1 (odd orders)**: For odd `n > 1`, `L^e_n = L^o_n` and `Δ_n = 0`. -/
theorem odd_order_delta_zero (n : ℕ) (hodd : Odd n) (hn : 1 < n) :
    evenCount n = oddCount n ∧ delta n = 0 :=
  sorry

open scoped Classical in
/-- **Section 1 (orbit congruence)**: For any finite `q`-group `G ≤ S_n^3` acting on even-order
Latin squares, `Δ_n ≡ ∑_{L : Stab_G(L) ≠ 1} ε(L) (mod |G|)`. -/
theorem eq_orbit (n q : ℕ) (heven : Even n) (hq : q.Prime)
    (G : Subgroup (Isotopy n)) (hp : IsPGroup q G) :
    delta n ≡
      ∑ L ∈ Finset.univ.filter (fun L : LatinSquare n => ∃ g ∈ G, g ≠ 1 ∧ g • L = L),
        (squareSign L : ℤ) [ZMOD (Nat.card G : ℤ)] :=
  sorry

/-- **Sections 1 & 7 (small orders and headline criterion)**: `c_2 = 4`, `c_4 = 24`, `c_6 = 15`,
and for every even `n > 2`, `c_n > 1 ↔ n - 1` is prime. -/
theorem sec1_small_orders_and_headline :
    cVal 2 = 4 ∧ cVal 4 = 24 ∧ cVal 6 = 15 ∧
    ∀ n : ℕ, Even n → 2 < n → (1 < cVal n ↔ (n - 1).Prime) :=
  sorry

/-- **Section 1 (Figure 1 caption)**: All Latin squares of orders `2` and `4` are even, while
order `6` has both even and odd Latin squares. -/
theorem sec1_fig1_small_counts :
    oddCount 2 = 0 ∧ oddCount 4 = 0 ∧ 0 < evenCount 6 ∧ 0 < oddCount 6 :=
  sorry

/-- **Section 2 (Janssen's identity)**: `sgn_row(L) * sgn_col(L) * sgn_sym(L) = (-1)^(n(n-1)/2)`. -/
theorem eq_janssen (n : ℕ) (L : LatinSquare n) :
    rowSign L * colSign L * symSign L = (-1 : ℤˣ) ^ (n * (n - 1) / 2) :=
  sorry

/-- **Section 2 (Isotopy invariance)**: Sign transformation formulas under isotopies, and
invariance `ε(σ L) = ε(L)` for even `n`. -/
theorem eq_isotopy (n : ℕ) (σ : Isotopy n) (L : LatinSquare n) :
    rowSign (σ • L) =
      rowSign L * (Equiv.Perm.sign σ.2.1 * Equiv.Perm.sign σ.2.2) ^ n ∧
    colSign (σ • L) =
      colSign L * (Equiv.Perm.sign σ.1 * Equiv.Perm.sign σ.2.2) ^ n ∧
    (Even n → squareSign (σ • L) = squareSign L) :=
  sorry

/-- **Section 2 (Normalization)**: For even `n`, `Δ_n = n! (n-1)! D_n`. -/
theorem eq_normal (n : ℕ) (heven : Even n) :
    delta n = ((n.factorial * (n - 1).factorial : ℕ) : ℤ) * reducedDelta n :=
  sorry

/-- **Section 2 (Reduced formula for `c_n`)**: For positive even `n`,
`c_n = (n! n) / gcd(|D_n|, n! n)`, and for every prime `q`, `q ∤ c_n ↔ M_q(n) ∣ D_n`. -/
theorem eq_cn_reduced (n : ℕ) (heven : Even n) (hn : 0 < n) :
    cVal n = (n.factorial * n) / Nat.gcd (reducedDelta n).natAbs (n.factorial * n) ∧
    ∀ q : ℕ, q.Prime → (¬ (q ∣ cVal n) ↔ (naturalModulus q n : ℤ) ∣ reducedDelta n) :=
  sorry

/-! ### Section 3: The Circuit Partition Polynomial and Vertex Removal -/

/-- **Lemma 3.1**: If `H` is `d`-regular on `N` vertices with matrix `M = M(H)`, then
`j(H; -d) = (-1)^(Nd) (∏_{u,v} M_{uv}!) [x^M] det(X)^d`. -/
theorem lem_3_1_quad_fact {V : Type} [Fintype V] [DecidableEq V]
    (H : Multidigraph V) (d : ℕ) (hreg : IsRegular H d) :
    (circuitPoly H).eval (-(d : ℤ)) =
      (-1 : ℤ) ^ (Fintype.card V * d) *
        (∏ u : V, ∏ v : V, ((adjMatrix H u v).factorial : ℤ)) *
        detPowCoeff (adjMatrix H) d :=
  sorry

/-- **Lemma 3.2**: For even `n`, `j(K_n^∘; -n) = [x^J] det(X)^n = (-1)^(n/2) Δ_n`. -/
theorem lem_3_2_quad_latin (n : ℕ) (heven : Even n) :
    (circuitPoly (completeLoopDigraph n)).eval (-(n : ℤ)) =
      detPowCoeff (allOnesMatrix (Fin n)) n ∧
    detPowCoeff (allOnesMatrix (Fin n)) n = (-1 : ℤ) ^ (n / 2) * delta n :=
  sorry

/-- **Lemma 3.3**: Single-vertex removal: every `H_σ` is `d`-regular, polynomial identity (E),
and `x = -d` profile identity (E'). -/
theorem lem_3_3_quad_elim {V : Type} [Fintype V] [DecidableEq V]
    (H : Multidigraph V) (d : ℕ) (hreg : IsRegular H d) (hV : 2 ≤ Fintype.card V) (w : V) :
    (∀ σ : nonLoopIn H w ≃ nonLoopOut H w, IsRegular (elimDigraph H w σ) d) ∧
    (circuitPoly H =
      (∏ i ∈ Finset.range (adjMatrix H w w),
        (Polynomial.X + Polynomial.C (((d - adjMatrix H w w + i : ℕ) : ℤ)))) *
      (∑ σ : nonLoopIn H w ≃ nonLoopOut H w, circuitPoly (elimDigraph H w σ))) ∧
    (let M := adjMatrix H
     circuitEval M d =
      (-1 : ℤ) ^ (M w w) * ((M w w).factorial : ℤ) *
        ∑ R : { R : Matrix { v : V // v ≠ w } { v : V // v ≠ w } ℕ // ValidProfile M w R },
          (profileCount M w R.1 : ℤ) * circuitEval (subMatrix M w + R.1) d) :=
  sorry

/-- **Corollary 3.4**: In Lemma 3.3, for every prime `q`,
`v_q(j(M)) ≥ v_q(∏_{u ∈ V} M_{uw}!) + min_R v_q(j(M' + R))`. -/
theorem cor_3_4_quad_elim {V : Type} [Fintype V] [DecidableEq V]
    (H : Multidigraph V) (d q : ℕ) (hreg : IsRegular H d) (hV : 2 ≤ Fintype.card V)
    (w : V) (hq : q.Prime) :
    let M := adjMatrix H
    qVal q (circuitEval M d) ≥
      (padicValNat q (∏ u : V, (M u w).factorial) : ℕ∞) +
        ⨅ R : { R : Matrix { v : V // v ≠ w } { v : V // v ≠ w } ℕ // ValidProfile M w R },
          qVal q (circuitEval (subMatrix M w + R.1) d) :=
  sorry

/-- **Proposition 3.5**: If `H` is `n`-regular on `N ≥ 1` vertices with all `M_{uv} ≥ 1`, then
`v_q(j(M)) ≥ ∑_{N'=1}^N f_q(n, N')` for every prime `q`. -/
theorem prop_3_5_quad_ind {V : Type} [Fintype V] [DecidableEq V]
    (H : Multidigraph V) (n q : ℕ) (hreg : IsRegular H n) (hV : 1 ≤ Fintype.card V)
    (hpos : ∀ u v : V, 1 ≤ adjMatrix H u v) (hq : q.Prime) :
    qVal q (circuitEval (adjMatrix H) n) ≥
      (∑ N' ∈ Finset.Icc 1 (Fintype.card V), fVal q n N' : ℕ∞) :=
  sorry

/-- **Proposition 3.6**: For positive even `n`,
`Δ_n = (-1)^(n/2 + 1) (n-1)! j(J_{n-1} + I_{n-1})`. -/
theorem prop_3_6_identity (n : ℕ) (heven : Even n) (hn : 2 ≤ n) :
    delta n =
      (-1 : ℤ) ^ (n / 2 + 1) * ((n - 1).factorial : ℤ) *
        circuitEval (allOnesMatrix (Fin (n - 1)) + (1 : Matrix (Fin (n - 1)) (Fin (n - 1)) ℕ)) n :=
  sorry

/-- **Section 3 (Figure 4 caption)**: For `n = 4` and the `4`-regular multidigraph `H` with
adjacency matrix `J_3 + I_3`, removing any vertex `w` yields two virtual-arc graphs and
`j(H; x) = (x + 2)(x + 3) ∑_σ j(H_σ; x)`. -/
theorem sec3_fig4_elim_n4 {H : Multidigraph (Fin 3)}
    (hM : adjMatrix H = allOnesMatrix (Fin 3) + (1 : Matrix (Fin 3) (Fin 3) ℕ))
    (w : Fin 3) :
    Fintype.card (nonLoopIn H w ≃ nonLoopOut H w) = 2 ∧
    circuitPoly H =
      (Polynomial.X + Polynomial.C 2) * (Polynomial.X + Polynomial.C 3) *
        ∑ σ : nonLoopIn H w ≃ nonLoopOut H w, circuitPoly (elimDigraph H w σ) :=
  sorry

/-! ### Section 4: A Quadratic Bound -/

/-- **Theorem 4.1**: For even `n ≥ 2`: (a) exact `f_q` sum bound, (b) `n^2/4` bound at `q = 2`,
and (c) natural-modulus divisibility for `q = 2, n ≥ 8` and odd primes `3q ≤ n`. -/
theorem thm_4_1_quadratic (n : ℕ) (heven : Even n) (hn : 2 ≤ n) :
    (∀ q : ℕ, q.Prime →
      qVal q (delta n) ≥
        (padicValNat q (n - 1).factorial : ℕ∞) +
          (∑ N ∈ Finset.Icc 1 (n - 1), fVal q n N : ℕ∞)) ∧
    (qVal 2 (delta n) ≥
      (padicValNat 2 (n - 1).factorial : ℕ∞) + ((n ^ 2 / 4 : ℕ) : ℕ∞)) ∧
    (∀ q : ℕ, q.Prime →
      ((q = 2 ∧ 8 ≤ n) ∨ (q ≠ 2 ∧ 3 * q ≤ n)) →
        qVal q (delta n) ≥ (3 * padicValNat q n.factorial : ℕ∞) ∧
        (naturalModulus q n : ℤ) ∣ reducedDelta n) :=
  sorry

/-- **Corollary 4.2**: For every prime `q` and every even `n`, with `a = ⌊n/q⌋`,
`v_q(Δ_n) ≥ v_q(n! (n-1)!) + a(a-1)/2`. -/
theorem cor_4_2_floor (n q : ℕ) (heven : Even n) (hq : q.Prime) :
    qVal q (delta n) ≥
      (padicValNat q (n.factorial * (n - 1).factorial) : ℕ∞) +
        (((n / q) * (n / q - 1) / 2 : ℕ) : ℕ∞) :=
  sorry

/-- **Sections 1 & 4 (concrete numeric bounds, including Figure 5)**: At `n = 8`, `2^13 ∣ D_8`
and `M_2(8) = 2^10`; at `n = 26`, `2^181 ∣ D_26`, `2^146 ∣ D_26`, `M_2(26) = 2^24`, and
`c_26 = 1`; for `n = 2, 4, 6, 8, 10`, the RHS of Theorem 4.1(a) at `q = 2` equals
`1, 6, 13, 24, 37`. -/
theorem sec4_numeric_bounds :
    ((2 : ℤ) ^ 13 ∣ reducedDelta 8) ∧
    naturalModulus 2 8 = 2 ^ 10 ∧
    ((2 : ℤ) ^ 181 ∣ reducedDelta 26) ∧
    ((2 : ℤ) ^ 146 ∣ reducedDelta 26) ∧
    naturalModulus 2 26 = 2 ^ 24 ∧
    cVal 26 = 1 ∧
    padicValNat 2 1 + ∑ N ∈ Finset.Icc 1 1, fVal 2 2 N = 1 ∧
    padicValNat 2 (Nat.factorial 3) + ∑ N ∈ Finset.Icc 1 3, fVal 2 4 N = 6 ∧
    padicValNat 2 (Nat.factorial 5) + ∑ N ∈ Finset.Icc 1 5, fVal 2 6 N = 13 ∧
    padicValNat 2 (Nat.factorial 7) + ∑ N ∈ Finset.Icc 1 7, fVal 2 8 N = 24 ∧
    padicValNat 2 (Nat.factorial 9) + ∑ N ∈ Finset.Icc 1 9, fVal 2 10 N = 37 :=
  sorry

/-! ### Section 5: The Odd Primes `q` with `n / 3 < q < n / 2` -/

/-- **Lemma 5.1**: Subset elimination `V = S ⊔ T` (`S ≠ ∅`):
`j(H; x) = ∑_{π_T} x^{cyc_T} j(H_{π_T}; x)`, and each `H_{π_T}` is `d`-regular on `S`
with matrix `M_S + R` whose row/column sums equal exit/entry counts. -/
theorem lem_5_1_quad_split {V : Type} [Fintype V] [DecidableEq V]
    (H : Multidigraph V) (d : ℕ) (hreg : IsRegular H d) (S : Finset V) (hS : S.Nonempty) :
    circuitPoly H =
      ∑ πT : PartialTransition H S,
        Polynomial.X ^ cycInsideT H S πT * circuitPoly (splitDigraph H S πT) ∧
    ∀ πT : PartialTransition H S,
      IsRegular (splitDigraph H S πT) d ∧
      ∃ R : Matrix { v : V // v ∈ S } { v : V // v ∈ S } ℕ,
        adjMatrix (splitDigraph H S πT) =
          Matrix.of (fun u v => adjMatrix H u.1 v.1) + R ∧
        (∀ u : { v : V // v ∈ S },
          ∑ v, R u v = (Finset.univ.filter fun a : H.Arc => H.tail a = u.1 ∧ H.head a ∉ S).card) ∧
        (∀ v : { v : V // v ∈ S },
          ∑ u, R u v = (Finset.univ.filter fun a : H.Arc => H.tail a ∉ S ∧ H.head a = v.1).card) :=
  sorry

/-- **Remark 5.2**: Automorphism invariance of `cyc_T` and `j(H_{π_T}; x)` on orbits, and
induced automorphism of `H_{π_T}` when `g π_T = π_T`. -/
theorem rem_5_2_aut {V : Type} [Fintype V] [DecidableEq V]
    (H : Multidigraph V) (S : Finset V) (g : MultidigraphAut H)
    (hS : ∀ v, v ∈ S ↔ g.vPerm v ∈ S) (πT : PartialTransition H S) :
    cycInsideT H S (autActPartial g hS πT) = cycInsideT H S πT ∧
    circuitPoly (splitDigraph H S (autActPartial g hS πT)) = circuitPoly (splitDigraph H S πT) ∧
    (autActPartial g hS πT = πT →
      ∃ gS : MultidigraphAut (splitDigraph H S πT),
        ∀ u : { v : V // v ∈ S }, (gS.vPerm u).1 = g.vPerm u.1) :=
  sorry

/-- **Lemma 5.3**: For prime `q` and `n > 2q`, if `H` is `n`-regular on at least 2 vertices
with all `M_{uv} ≥ 1`, then `v_q(j(M)) ≥ 3`. -/
theorem lem_5_3_three {V : Type} [Fintype V] [DecidableEq V]
    (H : Multidigraph V) (q n : ℕ) (hq : q.Prime) (hn : 2 * q < n)
    (hreg : IsRegular H n) (hV : 2 ≤ Fintype.card V)
    (hpos : ∀ u v : V, 1 ≤ adjMatrix H u v) :
    (3 : ℕ∞) ≤ qVal q (circuitEval (adjMatrix H) n) :=
  sorry

/-- **Lemma 5.4**: For odd prime `q` and `n > 2q`, if `H` is `n`-regular on `S₀ ⊔ S₁` with
`|S₀| = |S₁| = q`, all `M_{uv} ≥ 1`, `M_{ab} = 1` for `a ∈ S₀, b ∈ S₁`, and `g` is an
automorphism of order `q` fixing `S₀` pointwise and acting transitively on `S₁`, then
`v_q(j(M)) ≥ 4`. -/
theorem lem_5_4_quad_S {V : Type} [Fintype V] [DecidableEq V]
    (H : Multidigraph V) (q n : ℕ) (hq : q.Prime) (hodd : q ≠ 2) (hn : 2 * q < n)
    (hreg : IsRegular H n) (S₀ S₁ : Finset V)
    (hdisj : Disjoint S₀ S₁) (hcov : S₀ ∪ S₁ = Finset.univ)
    (hcard0 : S₀.card = q) (hcard1 : S₁.card = q)
    (hpos : ∀ u v : V, 1 ≤ adjMatrix H u v)
    (h1 : ∀ a ∈ S₀, ∀ b ∈ S₁, adjMatrix H a b = 1)
    (g : MultidigraphAut H) (hord : orderOf g = q)
    (hfix : ∀ a ∈ S₀, g.vPerm a = a)
    (htrans : ∀ b₁ ∈ S₁, ∀ b₂ ∈ S₁, ∃ k : ℕ, (g.vPerm ^ k) b₁ = b₂) :
    (4 : ℕ∞) ≤ qVal q (circuitEval (adjMatrix H) n) :=
  sorry

/-- **Theorem 5.5**: For odd prime `q` and even `n` with `2q < n < 3q`, `q^2 ∣ D_n`,
`v_q(n!) = 2`, `q ∤ n`, and `M_q(n) ∣ D_n`. -/
theorem thm_5_5_quad_P (q n : ℕ) (hq : q.Prime) (hodd : q ≠ 2) (heven : Even n)
    (hlo : 2 * q < n) (hhi : n < 3 * q) :
    (q : ℤ) ^ 2 ∣ reducedDelta n ∧
    padicValNat q n.factorial = 2 ∧
    ¬ (q ∣ n) ∧
    (naturalModulus q n : ℤ) ∣ reducedDelta n :=
  sorry

/-- **Section 5 (boundary case `n = 3q - 1`)**: For odd prime `q`, `v_q(Δ_{3q-1}) ≥ 7`. -/
theorem sec5_three_q_minus_one (q : ℕ) (hq : q.Prime) (hodd : q ≠ 2) :
    (7 : ℕ∞) ≤ qVal q (delta (3 * q - 1)) :=
  sorry

/-! ### Section 6: The Prime `q = n / 2` -/

/-- **Theorem 6.1**: For every odd prime `q`, `q^2 ∣ D_{2q}`, and for every prime `q ≥ 5`,
`q^3 ∣ D_{2q}`. -/
theorem thm_6_1_twoq (q : ℕ) (hq : q.Prime) (hodd : q ≠ 2) :
    ((q : ℤ) ^ 2 ∣ reducedDelta (2 * q)) ∧
    (5 ≤ q → (q : ℤ) ^ 3 ∣ reducedDelta (2 * q)) :=
  sorry

/-- **Lemma 6.2**: Möbius reduction for a finite `q`-group acting on a finite set with
invariant sign `ε : X → {±1}`. -/
theorem lem_6_2_mobius {G X : Type*} [Group G] [Fintype G] [Fintype X] [MulAction G X]
    (q : ℕ) (hq : q.Prime) (hp : IsPGroup q G)
    (ε : X → ℤˣ) (hinv : ∀ g : G, ∀ x : X, ε (g • x) = ε x) :
    (∑ x : X, (ε x : ℤ)) ≡
      -(∑ H ∈ elemAbelianNontrivial (G := G) q,
        (-1 : ℤ) ^ (elemRank q H) * (q : ℤ) ^ ((elemRank q H).choose 2) *
          signedFixSum ε H) [ZMOD (Fintype.card G : ℤ)] :=
  sorry

/-- **Lemma 6.3**: Every subgroup of `P ≅ F_q^6` fixing a Latin square of order `2q` has rank
at most `3`, and `Δ_{2q} ≡ ∑_{r=1} S(H) - q ∑_{r=2} S(H) + q^3 ∑_{r=3} S(H) (mod q^6)`. -/
theorem lem_6_3_orbred (q : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2) :
    (∀ H : Subgroup (sylowP q),
      (fixSet (H.map (sylowP q).subtype) : Set (LatinSquare (2 * q))).Nonempty →
        elemRank q H ≤ 3) ∧
    (delta (2 * q) ≡
      (∑ H ∈ sylowSubgroupsOfRank q 1, S_twoq q H) -
      (q : ℤ) * (∑ H ∈ sylowSubgroupsOfRank q 2, S_twoq q H) +
      (q : ℤ) ^ 3 * (∑ H ∈ sylowSubgroupsOfRank q 3, S_twoq q H) [ZMOD (q : ℤ) ^ 6]) :=
  sorry

/-- **Lemma 6.4**: Orbit sign constancy and orbit-representative product formula, block
permutation / Zolotarev signs, block-swap and block-scale normalizers of `P`, and
sign-preserving bijections on `Fix(H)` under normalizers and transposition. -/
theorem lem_6_4_signs (q : ℕ) [Fact q.Prime] (hodd : q ≠ 2) :
    (∀ (H : Subgroup (sylowP q)) (L : LatinSquare (2 * q)),
      L ∈ fixSet (H.map (sylowP q).subtype) →
        (∀ g ∈ H,
          (∀ r : Fin (2 * q), Equiv.Perm.sign (rowPerm L (g.1.1 r)) =
            Equiv.Perm.sign (rowPerm L r)) ∧
          (∀ c : Fin (2 * q), Equiv.Perm.sign (colPerm L (g.1.2.1 c)) =
            Equiv.Perm.sign (colPerm L c))) ∧
        (∀ r : Fin (2 * q),
          Nat.card { r' : Fin (2 * q) // ∃ g ∈ H, g.1.1 r = r' } = 1 ∨
          Nat.card { r' : Fin (2 * q) // ∃ g ∈ H, g.1.1 r = r' } = q) ∧
        (∀ c : Fin (2 * q),
          Nat.card { c' : Fin (2 * q) // ∃ g ∈ H, g.1.2.1 c = c' } = 1 ∨
          Nat.card { c' : Fin (2 * q) // ∃ g ∈ H, g.1.2.1 c = c' } = q) ∧
        (∀ (R C : Finset (Fin (2 * q))),
          (∀ r : Fin (2 * q), ∃! r₀ ∈ R, ∃ g ∈ H, g.1.1 r₀ = r) →
          (∀ c : Fin (2 * q), ∃! c₀ ∈ C, ∃ g ∈ H, g.1.2.1 c₀ = c) →
          squareSign L =
            (∏ r ∈ R, Equiv.Perm.sign (rowPerm L r)) *
            (∏ c ∈ C, Equiv.Perm.sign (colPerm L c)))) ∧
    (∀ (ϖ : Equiv.Perm (Fin 2)) (φ : Fin 2 → Equiv.Perm (ZMod q)),
      Equiv.Perm.sign
        ((blockEquiv q).symm.trans <|
          ({ toFun := fun p => (ϖ p.1, φ p.1 p.2)
             invFun := fun p => (ϖ.symm p.1, (φ (ϖ.symm p.1)).symm p.2)
             left_inv := fun p => by ext <;> simp
             right_inv := fun p => by ext <;> simp } : Equiv.Perm (Fin 2 × ZMod q)).trans
          (blockEquiv q)) =
        (if ϖ = 1 then 1 else -1) * Equiv.Perm.sign (φ 0) * Equiv.Perm.sign (φ 1)) ∧
    (∀ t : ZMod q, Equiv.Perm.sign (Equiv.addRight t) = 1) ∧
    (∀ lam : (ZMod q)ˣ,
      (Equiv.Perm.sign (Equiv.mulLeft₀ lam.1 (Units.ne_zero lam)) : ℤ) =
        (legendreSym q (lam.1.val : ℤ))) ∧
    ((∀ g ∈ sylowP q, (blockSwapPerm q, 1, 1) * g * (blockSwapPerm q, 1, 1)⁻¹ ∈ sylowP q) ∧
     (∀ g ∈ sylowP q, (1, blockSwapPerm q, 1) * g * (1, blockSwapPerm q, 1)⁻¹ ∈ sylowP q) ∧
     (∀ g ∈ sylowP q, (1, 1, blockSwapPerm q) * g * (1, 1, blockSwapPerm q)⁻¹ ∈ sylowP q) ∧
     (∀ (a₀ : Fin 2) (lam : (ZMod q)ˣ),
       (∀ g ∈ sylowP q,
         (blockScalePerm q a₀ lam, 1, 1) * g * (blockScalePerm q a₀ lam, 1, 1)⁻¹ ∈ sylowP q) ∧
       (∀ g ∈ sylowP q,
         (1, blockScalePerm q a₀ lam, 1) * g * (1, blockScalePerm q a₀ lam, 1)⁻¹ ∈ sylowP q) ∧
       (∀ g ∈ sylowP q,
         (1, 1, blockScalePerm q a₀ lam) * g * (1, 1, blockScalePerm q a₀ lam)⁻¹ ∈ sylowP q))) ∧
    (∀ ψ : Isotopy (2 * q),
      (∀ g ∈ sylowP q, ψ * g * ψ⁻¹ ∈ sylowP q) →
      (∀ L : LatinSquare (2 * q), squareSign (ψ • L) = squareSign L) ∧
      ∀ H : Subgroup (sylowP q),
        Set.BijOn (fun L : LatinSquare (2 * q) => ψ • L)
          (fixSet (H.map (sylowP q).subtype))
          (fixSet ((H.map (sylowP q).subtype).map (MulAut.conj ψ).toMonoidHom)) ∧
        signedFixSum (squareSign (n := 2 * q))
          ((H.map (sylowP q).subtype).map (MulAut.conj ψ).toMonoidHom) = S_twoq q H) ∧
    ((∀ L : LatinSquare (2 * q), squareSign (transposeSquare L) = squareSign L) ∧
     ∀ (H : Subgroup (sylowP q)),
      Set.BijOn (transposeSquare (n := 2 * q))
        (fixSet (H.map (sylowP q).subtype))
        (fixSet ((transposeSubgroup H).map (sylowP q).subtype)) ∧
      S_twoq q (transposeSubgroup H) = S_twoq q H) :=
  sorry

/-- **Lemma 6.5**: For odd prime `q`, `τ_q = q * t_q`, `t_q ≡ -1 (mod q)`, and the
`δ`-scaled complete-map signed sum equals `τ_q` for every `δ ≠ 0`. -/
theorem lem_6_5_complete (q : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2) :
    tauQ q = (q : ℤ) * tQ q ∧
    tQ q ≡ -1 [ZMOD (q : ℤ)] ∧
    ∀ δ : ZMod q, δ ≠ 0 →
      (∑ h : { h : Equiv.Perm (ZMod q) // Function.Bijective (fun x => h x - δ * x) },
        (Equiv.Perm.sign h.1 : ℤ) *
          (Equiv.Perm.sign (Equiv.ofBijective (fun x => h.1 x - δ * x) h.2) : ℤ)) =
      tauQ q :=
  sorry

/-- **Lemma 6.6**: (i) Fixed row or column gives `S(H) = 0`; (ii) rank 3 gives `q^3 ∣ S(H)`;
(iii) exact formula for `∑_{r(H)=2} S(H)` and divisibility by `q^5`. -/
theorem lem_6_6_vanish (q : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2) :
    (∀ H : Subgroup (sylowP q), H ≠ ⊥ →
      ((∃ c : Fin (2 * q), ∀ g ∈ H, g.1.2.1 c = c) ∨
       (∃ r : Fin (2 * q), ∀ g ∈ H, g.1.1 r = r)) →
        S_twoq q H = 0) ∧
    (∀ H : Subgroup (sylowP q), elemRank q H = 3 →
      (∀ L : LatinSquare (2 * q), L ∈ fixSet (H.map (sylowP q).subtype) →
        ∀ g : sylowP q, g.1 • L = L → g ∈ H) ∧
      (q : ℤ) ^ 3 ∣ S_twoq q H) ∧
    ((∑ H ∈ sylowSubgroupsOfRank q 2, S_twoq q H) =
      2 * (q : ℤ) ^ 4 * ((q : ℤ) - 1) ^ 5 * ((q : ℤ) - 2) * ((q : ℤ) + 1) -
      8 * (q : ℤ) ^ 3 * ((q : ℤ) - 1) ^ 5 * tauQ q +
      4 * (q : ℤ) ^ 2 * ((q : ℤ) - 1) ^ 4 * (q.factorial : ℤ) ^ 2) ∧
    ((q : ℤ) ^ 5 ∣ ∑ H ∈ sylowSubgroupsOfRank q 2, S_twoq q H) :=
  sorry

/-- **Lemma 6.7**: For `ℓ ∈ {ℓ_0, ℓ_B, ℓ_C}` and `L ∈ Fix(⟨ℓ⟩)`, `ε(L)` is the product of
`ω(h)` over the moving symbol blocks of `L` (and `1` for `ℓ_0`). -/
theorem lem_6_7_factor (q : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2) :
    (∀ L : LatinSquare (2 * q),
      L ∈ fixSet ((Subgroup.zpowers (ell0 q)).map (sylowP q).subtype) →
        squareSign L = 1) ∧
    (∀ (L : LatinSquare (2 * q)) (m : ℕ) (hm : m ≤ q) (O : Pattern q m)
      (h1 : Layer (O.compl hm)),
      L ∈ fixSet ((Subgroup.zpowers (ellB q)).map (sylowP q).subtype) →
      (∀ a b : Fin 2, ∀ x d : ZMod q,
        (d ∈ O.O a b ↔
          ((blockEquiv q).symm (L.entry (blockEquiv q (a, x)) (blockEquiv q (b, x + d)))).1 = 0) ∧
        ∀ hd : d ∈ (O.compl hm).O a b,
          L.entry (blockEquiv q (a, x)) (blockEquiv q (b, x + d)) =
            blockEquiv q (1, x + h1.h a b ⟨d, hd⟩)) →
        squareSign L = layerSign h1) ∧
    (∀ (L : LatinSquare (2 * q)) (m : ℕ) (hm : m ≤ q) (O : Pattern q m)
      (h0 : Layer O) (h1 : Layer (O.compl hm)),
      L ∈ fixSet ((Subgroup.zpowers (ellC q)).map (sylowP q).subtype) →
      (∀ a b : Fin 2, ∀ x d : ZMod q,
        (∀ hd : d ∈ O.O a b,
          L.entry (blockEquiv q (a, x)) (blockEquiv q (b, x + d)) =
            blockEquiv q (0, x + h0.h a b ⟨d, hd⟩)) ∧
        (∀ hd : d ∈ (O.compl hm).O a b,
          L.entry (blockEquiv q (a, x)) (blockEquiv q (b, x + d)) =
            blockEquiv q (1, x + h1.h a b ⟨d, hd⟩))) →
        squareSign L = layerSign h0 * layerSign h1) :=
  sorry

/-- **Lemma 6.8**: (a) `S(⟨ℓ_0⟩) = C(2q, q) (q!)^4 = (2q)! (q!)^2` with all squares even;
(b) mixed-stratum squares have `Stab_P(L) = ⟨ℓ⟩`; (c) homogeneous strata contribute
`2 (q!)^2 τ_q^2` for `ℓ_B` and `2 τ_q^4` for `ℓ_C`. -/
theorem lem_6_8_strata (q : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2) :
    (S_twoq q (Subgroup.zpowers (ell0 q)) =
      ((2 * q).choose q : ℤ) * (q.factorial : ℤ) ^ 4 ∧
     S_twoq q (Subgroup.zpowers (ell0 q)) =
      ((2 * q).factorial : ℤ) * (q.factorial : ℤ) ^ 2 ∧
     ∀ L : LatinSquare (2 * q),
      L ∈ fixSet ((Subgroup.zpowers (ell0 q)).map (sylowP q).subtype) →
        squareSign L = 1) ∧
    (∀ ℓ ∈ ({ellB q, ellC q} : Finset (sylowP q)),
      ∀ L : LatinSquare (2 * q),
        L ∈ fixSet ((Subgroup.zpowers ℓ).map (sylowP q).subtype) →
        0 < stratumOf q L → stratumOf q L < q →
        ∀ g : sylowP q, g.1 • L = L ↔ g ∈ Subgroup.zpowers ℓ) ∧
    (homogStrataSum q (ellB q) = 2 * (q.factorial : ℤ) ^ 2 * (tauQ q) ^ 2) ∧
    (homogStrataSum q (ellC q) = 2 * (tauQ q) ^ 4) ∧
    (S_twoq q (Subgroup.zpowers (ellB q)) =
      2 * (q.factorial : ℤ) ^ 2 * (tauQ q) ^ 2 + (q : ℤ) ^ 5 * NB q) ∧
    (S_twoq q (Subgroup.zpowers (ellC q)) =
      2 * (tauQ q) ^ 4 + (q : ℤ) ^ 5 * NC q) :=
  sorry

/-- **Proposition 6.9**: `Δ_{2q} ≡ q^5 (2 N_B - N_C) (mod q^6)`, hence `q^2 ∣ D_{2q}` and
`2 * (D_{2q} / q^2) ≡ 2 N_B - N_C (mod q)`. -/
theorem prop_6_9_rankone (q : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2) :
    delta (2 * q) ≡ (q : ℤ) ^ 5 * (2 * NB q - NC q) [ZMOD (q : ℤ) ^ 6] ∧
    ((q : ℤ) ^ 2 ∣ reducedDelta (2 * q)) ∧
    2 * (reducedDelta (2 * q) / (q : ℤ) ^ 2) ≡ 2 * NB q - NC q [ZMOD (q : ℤ)] :=
  sorry

/-- **Lemma 6.10**: For `0 < m < q`,
`N_{B,m} = (q-1)! m! (q-m)! ∑_O Ω(O^c)` and `N_{C,m} = ∑_O Ω(O) Ω(O^c)`. -/
theorem lem_6_10_layers (q m : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2)
    (hm0 : 0 < m) (hmq : m < q) :
    mixedOrbitCountB q m =
      (((q - 1).factorial * m.factorial * (q - m).factorial : ℕ) : ℤ) *
        ∑ O ∈ centeredPatterns q m, OmegaSum (O.compl (le_of_lt hmq)) ∧
    mixedOrbitCountC q m =
      ∑ O ∈ centeredPatterns q m, OmegaSum O * OmegaSum (O.compl (le_of_lt hmq)) :=
  sorry

/-- **Lemma 6.11**: Trace formulas for `Z_Y(I, J)`, `Ω(O)`, `Ω(O^c)`, symmetry of
`E, F, U`, and `∑_O Ω(O^c) = tr((E F)^2)`, `N_{C,m} = tr((U S)^4)`. -/
theorem lem_6_11_traces (q m : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2)
    (hm0 : 0 < m) (hmq : m < q) :
    (∀ Y I J : Finset (ZMod q), ∀ hIJ : I.card = J.card,
      Y.card = I.card →
      ZY Y I J = (circulantSubmatrix hIJ).det.coeff (subsetMonomial Y)) ∧
    (∀ (O : Pattern q m) (hO : O.IsCentered),
      let hq_odd : Odd q := hq.odd_of_ne_two hodd
      let X1 : CenteredIdx q m :=
        ⟨O.O 0 0, Finset.mem_filter.mpr ⟨Finset.mem_univ _, O.card_00, hO 0 0⟩⟩
      let X2 : CenteredIdx q m := complCentered hq_odd (le_of_lt hmq) (O.O 0 1) O.card_01 (hO 0 1)
      let X3 : CenteredIdx q m := complCentered hq_odd (le_of_lt hmq) (O.O 1 0) O.card_10 (hO 1 0)
      let X4 : CenteredIdx q m :=
        ⟨O.O 1 1, Finset.mem_filter.mpr ⟨Finset.mem_univ _, O.card_11, hO 1 1⟩⟩
      OmegaSum O =
        Matrix.trace (matA q m X1 * (matB q m X3)ᵀ * matA q m X4 * (matB q m X2)ᵀ) ∧
      OmegaSum (O.compl (le_of_lt hmq)) =
        Matrix.trace (matB q m X1 * (matA q m X3)ᵀ * matB q m X4 * (matA q m X2)ᵀ)) ∧
    (∀ X : CenteredIdx q m,
      (matA q m X)ᵀ = matA q m (negCentered X) ∧
      (matB q m X)ᵀ = matB q m (negCentered X)) ∧
    ((matE q m)ᵀ = matE q m ∧ (matF q m)ᵀ = matF q m ∧ (matU q m)ᵀ = matU q m) ∧
    ((∑ O ∈ centeredPatterns q m, OmegaSum (O.compl (le_of_lt hmq))) =
      Matrix.trace ((matE q m * matF q m) ^ 2) ∧
     mixedOrbitCountC q m = Matrix.trace ((matU q m * matS q m) ^ 4)) :=
  sorry

/-- **Proposition 6.12**: For odd prime `q` and `0 < m < q`,
`N_{B,m} ≡ N_{C,m} ≡ 1 / m^2 (mod q)`. -/
theorem prop_6_12_zeval (q m : ℕ) [NeZero q] (hq : q.Prime) (hodd : q ≠ 2)
    (hm0 : 0 < m) (hmq : m < q) :
    ((mixedOrbitCountB q m : ZMod q) = ((m : ZMod q) ^ 2)⁻¹) ∧
    ((mixedOrbitCountC q m : ZMod q) = ((m : ZMod q) ^ 2)⁻¹) :=
  sorry

/-- **Section 6 (exact 3-part at `n = 6` and in-text identities)**: At `q = 3`, `D_6 / 9 ≡ 1 (mod 3)`,
`9 ∥ D_6`, `τ_3 = -3`, and the rank-2 sum equals `62208`; for any odd prime `q` and `0 < m < q`,
`|C_m| = C(q, m) / q`. -/
theorem sec6_concrete_in_text :
    (reducedDelta 6 / 9 ≡ 1 [ZMOD 3] ∧ ¬ ((27 : ℤ) ∣ reducedDelta 6)) ∧
    tauQ 3 = -3 ∧
    (∑ H ∈ sylowSubgroupsOfRank 3 2, S_twoq 3 H) = 62208 ∧
    ∀ (q m : ℕ) [NeZero q], q.Prime → q ≠ 2 → 0 < m → m < q →
      (centeredSubsets q m).card = q.choose m / q :=
  sorry

